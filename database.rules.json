{
  "rules": {
    ".read": false,
    ".write": false,
    "board": {
      ".read": true,
      ".write": true,
      "current": {
        ".validate": "newData.hasChildren(['name', 'start', 'end']) && newData.child('name').isString() && newData.child('name').val().length >= 1 && newData.child('name').val().length <= 30 && newData.child('start').isNumber() && newData.child('end').isNumber()"
      },
      "queue": {
        "$id": {
          ".validate": "newData.hasChildren(['name']) && newData.child('name').isString() && newData.child('name').val().length >= 1 && newData.child('name').val().length <= 30"
        }
      },
      "history": {
        "$id": {
          ".validate": "newData.hasChildren(['name', 'start', 'end']) && newData.child('name').isString() && newData.child('start').isNumber() && newData.child('end').isNumber()"
        }
      },
      "$other": {
        ".validate": false
      }
    },
    "subscribers": {
      "$id": {
        ".write": "!data.exists() && newData.exists()",
        ".validate": "newData.hasChildren(['email', 'createdAt']) && newData.child('email').isString() && newData.child('email').val().length >= 5 && newData.child('email').val().length <= 100 && newData.child('email').val().matches(/^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$/) && newData.child('createdAt').isNumber()",
        "email": { ".validate": true },
        "createdAt": { ".validate": true },
        "$rest": { ".validate": false }
      }
    }
  }
}
